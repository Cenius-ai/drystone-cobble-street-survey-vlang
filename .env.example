# Drystone Cobble Street Survey — environment variables.
# Every value below is optional: the app boots with no .env at all.

# Session signing key. Left empty, app/settings.py logs a warning and uses the
# documented development fallback. Set a long random value before deploying.
SECRET_KEY=

# Embedded SQLite datastore. Relative paths resolve against the project root.
DATABASE_URL=sqlite:///./drystone.db

# Port the server binds on 0.0.0.0 when started with `python3 -m app`.
PORT=8000
